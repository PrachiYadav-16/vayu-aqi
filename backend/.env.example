# Copy to backend/.env and fill in what you have. Every key is optional:
# with none set, Vayu runs on its simulated feed and offline routing.

VAYU_JWT_SECRET=replace-with-a-long-random-string
VAYU_CORS_ORIGINS=http://localhost:5173
# VAYU_DATABASE_URL=postgresql+psycopg://vayu:vayu@localhost:5432/vayu

# Live air quality (either one switches off the simulator)
VAYU_OPENAQ_API_KEY=
VAYU_WAQI_TOKEN=

# Weather and traffic used as model inputs
VAYU_OPENWEATHER_API_KEY=
VAYU_TOMTOM_API_KEY=

# Routing and place search. Without a Google key, OSRM and Nominatim are used.
VAYU_GOOGLE_MAPS_API_KEY=

# Time-series store: sql (default) or influx
VAYU_TIMESERIES_BACKEND=sql
VAYU_INFLUX_URL=http://localhost:8086
VAYU_INFLUX_TOKEN=
VAYU_INFLUX_ORG=vayu
VAYU_INFLUX_BUCKET=aqi

# Firebase service account JSON for push notifications
VAYU_FIREBASE_CREDENTIALS_FILE=
